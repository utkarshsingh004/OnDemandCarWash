{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        }
      },

      "washer-route": {
        "ClusterId": "washer-cluster",
        "Match": {
          "Path": "/api/washer/{**catch-all}"
        }
      },

      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },

      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      },


      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger/auth/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },

      "customer-swagger": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/swagger/customer/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },

      "washer-swagger": {
        "ClusterId": "washer-cluster",
        "Match": {
          "Path": "/swagger/washer/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },

      "booking-swagger": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/swagger/booking/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },

      "notification-swagger": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/swagger/notification/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      }

    },

    "Clusters": {

      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5279/"
          }
        }
      },

      "customer-cluster": {
        "Destinations": {
          "customer-destination": {
            "Address": "http://localhost:5180/"
          }
        }
      },

      "washer-cluster": {
        "Destinations": {
          "washer-destination": {
            "Address": "http://localhost:5239/"
          }
        }
      },

      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://localhost:5155/"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://localhost:5125/"
          }
        }
      }

    }
  }
}